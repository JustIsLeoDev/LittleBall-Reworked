; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Littleball"
config/description="Littleball"
run/main_scene="uid://cfqtahe3rh1o0"
config/features=PackedStringArray("4.8", "Forward Plus")
boot_splash/show_image=false
boot_splash/image="uid://duwppsgjo1yyv"
config/icon="uid://bvw2uaf507mri"

[audio]

buses/default_bus_layout="uid://v2qmyhsboy2i"

[autoload]

Points="*uid://bbfm2jguxsto4"
PM="*uid://4eiwccm4r634"
Global="*uid://bqh77vjo2fa6a"
PauseMenu="*uid://c6qhj8b1bn44x"
RoomSelectorDebug="uid://ctxlerlv30l32"
Deathscreen="*uid://d35fut3vchjla"
Set="*uid://cg1l2q07aicja"
SongSelector="*uid://3s80ewo5m055"
Transition="*uid://o8cty07j6vkf"
LevelPresentation="*uid://c8hrjt06egcuo"
DrugManager="*uid://bfxhyt8xtt8nx"
DiscordRPCLoader="*res://addons/discord-rpc-gd/nodes/discord_autoload.gd"
DiscordManager="*uid://b1mmlpjg2lcng"
MusicManager="*uid://bye7rrn8511s5"

[dialogic]

directories/dch_directory={}
directories/dtl_directory={}
layout/style_directory={}

[display]

window/size/viewport_width=640
window/size/viewport_height=480
window/size/resizable=false
window/size/transparent=true
window/size/sharp_corners=true
window/size/maximize_disabled=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=2

[dotnet]

project/assembly_name="Littleball Func"

[editor_plugins]

enabled=PackedStringArray("res://addons/discord-rpc-gd/plugin.cfg")

